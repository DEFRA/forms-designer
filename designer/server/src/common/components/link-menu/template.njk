{% from "govuk/macros/attributes.njk" import govukAttributes %}

{#
  App link menu

  A collapsible menu of navigation links, visually modelled on the MOJ Design
  System "Button menu", but built from real links.

  Unlike the MOJ component, the items are plain anchors with no `role="button"`
  and no `role="menu"`/`role="menuitem"`. They navigate to other pages, so they
  are announced as links, which is what they are.

  Progressive enhancement: this template renders a plain list of links, styled
  as a row of secondary buttons. Without JavaScript that is the finished
  component and every link is visible and usable. With JavaScript,
  `link-menu.js` collapses the list behind a disclosure toggle button.

  Params:
    id            (string)  id given to the list, referenced by the toggle
                            button's aria-controls. Required when more than one
                            menu appears on a page.
    button.text   (string)  label for the toggle button added by JavaScript
    button.classes(string)  extra classes for the toggle button
    alignMenu     (string)  "left" (default) or "right" - which edge of the
                            toggle button the open menu aligns to
    classes       (string)  extra classes for the component's root element
    attributes    (object)  extra attributes for the component's root element
    items         (array)   { text, href, classes, attributes } link items
#}

{%- set classNames = "app-link-menu" -%}
{%- if params.classes %}
  {%- set classNames = classNames + " " + params.classes -%}
{%- endif -%}

{%- set menuId = params.id | default("app-link-menu") -%}

{%- set menuAttributes = {
  "data-menu-text": {
    value: params.button.text,
    optional: true
  },
  "data-menu-classes": {
    value: params.button.classes,
    optional: true
  },
  "data-align-menu": {
    value: params.alignMenu,
    optional: true
  }
} if params.button else {
  "data-align-menu": {
    value: params.alignMenu,
    optional: true
  }
} -%}

<div class="{{ classNames }}" data-module="app-link-menu"{{ govukAttributes(params.attributes) }}{{ govukAttributes(menuAttributes) }}>
  <ul class="app-link-menu__list" id="{{ menuId }}">
    {% for item in params.items %}
      <li class="app-link-menu__list-item">
        <a class="govuk-button govuk-button--secondary app-link-menu__item{% if item.classes %} {{ item.classes }}{% endif %}" href="{{ item.href }}"{{ govukAttributes(item.attributes) }}>{{ item.text }}</a>
      </li>
    {% endfor %}
  </ul>
</div>
