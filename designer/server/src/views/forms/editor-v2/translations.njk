{% extends "layouts/page.njk" %}

{% from "editor-card/macro.njk" import appEditorCard %}
{% from "page-body/macro.njk" import appPageBody %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set mainClasses = "govuk-main-wrapper--masthead" %}

{% block content %}
  {% call appPageBody({
    heading: pageHeading,
    description: pageDescription,
    caption: pageCaption,
    useNewMasthead: useNewMasthead,
    classes: "govuk-grid-column-full",
    backLink: backLink,
    errorList: errorList
  }) %}

    {% if notification | length %}
      {% call govukNotificationBanner({
          type: "success"
        }) %}
      <p class="govuk-notification-banner__heading">{{ notification }}</p>
      {% endcall %}
    {% endif %}

    <div class="app-pages-header__actions govuk-button-group">
      <a href="welsh/upload" draggable="false" class="govuk-link govuk-link--no-visited-state govuk-!-margin-bottom-0">
        Upload
      </a>
      <a href="welsh/download" draggable="false" class="govuk-link govuk-link--no-visited-state govuk-!-margin-bottom-0">
        Download
      </a>
    </div>

    <form method="post" action="#">
      {% if (fieldTables | length) %}
        {% for fieldTable in fieldTables %}
          {% if (fieldTable.caption) %}
            <div class="govuk-!-margin-bottom-6">
              <div class="app-scrolling-wrapper" role="region" tabindex="0" aria-label="{{ fieldTable.caption }}">
                {{ govukTable(fieldTable) }}
              </div>
            </div>
            {% else %}
              <p class="govuk-body govuk-!-margin-bottom-9">&nbsp;</p>
            {% endif %}
        {% endfor %}
      {% endif %}

      <div class="govuk-button-group">
        {{ govukButton({
          text: 'Save changes'
        }) }}

        {{ govukButton({
          text: 'Preview form in Welsh',
          classes: 'govuk-button--secondary',
          href: previewBaseUrl,
          attributes: { target: "_blank" }
        }) }}

        <a href="/library/{{ formSlug }}/editor-v2/welsh/delete" class="govuk-link govuk-link--no-visited-state" id="delete-translations">Delete Welsh translations</a>
      </div>
    </form>

  {% endcall %}
{% endblock %}

{% block mainEnd %}
  {{ super() }}
{% endblock %}
