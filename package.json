    "path-webpack": "^0.0.3",
    "pino": "^10.3.1",
    "prismjs": "^1.30.0",
    "proxy-agent": "^6.5.0",
    "qs": "^6.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resolve": "^1.22.13",
    "serialize-javascript": "^7.0.3",
    "slug": "^11.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
