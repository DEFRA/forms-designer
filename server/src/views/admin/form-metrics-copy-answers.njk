{% extends "layouts/page.njk" %}

{% from "page-body/macro.njk" import appPageBody %}
{% from "metrics-overview/macro.njk" import appMetricsOverview %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{%- from "govuk/components/checkboxes/macro.njk" import govukCheckboxes -%}
{%- from "govuk/components/radios/macro.njk" import govukRadios -%}
{%- from "govuk/components/input/macro.njk" import govukInput -%}
{% from "page-navigation/macro.njk" import appPageNavigation %}
{% from "metrics-copy-answers/macro.njk" import appMetricsCopyAnswers %}

{% set mainClasses = "govuk-main-wrapper--masthead" %}

{% set last7DaysHtml %}
  {{ appMetricsCopyAnswers(model.overviewMetrics.last7Days) }}
{% endset -%}

{% set last30DaysHtml %}
  {{ appMetricsCopyAnswers(model.overviewMetrics.last30Days) }}
{% endset -%}

{% set allTimeHtml %}
  {{ appMetricsCopyAnswers(model.overviewMetrics.allTime) }}
{% endset -%}

{% block content %}
  {% call appPageBody({
    heading: pageHeading,
    caption: caption,
    useNewMasthead: true,
    classes: "govuk-grid-column-full",
    backLink: backLink
  }) %}

    {{ appPageNavigation({
      extraClasses: "govuk-!-margin-bottom-8 govuk-!-margin-top-4",
      navItems: [
        {
          title: "Form activity",
          href: "/admin/form-metrics/form-activity/all?restoreFilter=Y"
        },
        {
          title: "Component usage",
          href: "/admin/form-metrics/component-usage"
        },
        {
          title: "Sign-in",
          href: "/admin/form-metrics/sign-in"
        },
        {
          title: "Copy answers",
          href: "/admin/form-metrics/copy-answers",
          active: true
        }
      ]
    }) }}

    <p class="govuk-body govuk-!-margin-bottom-6">Monitor copy answers adoption and submission activity across Defra Forms.</p>

    {{ govukTabs({
      items: [
        {
          label: "Last 7 days",
          id: "last-7-days",
          panel: {
            html: last7DaysHtml
          }
        },
        {
          label: "Last 30 days",
          id: "last-30-days",
          panel: {
            html: last30DaysHtml
          }
        },
        {
          label: "All time",
          id: "all-time",
          panel: {
            html: allTimeHtml
          }
        }
      ]
    }) }}

    <div class="moj-action-bar">
      <span class="govuk-heading-s pull-right">{{ model.formMetricRows.length }} row{{ 's' if model.formMetricRows.length !== 1 }}</span>
    </div>

    <table class="govuk-table moj-scrollable-pane" data-module="moj-sortable-table">
      <thead class="govuk-table__head">
        <tr class="govuk-table__row">
          <th scope="col" class="govuk-table__header" aria-sort="ascending">Form name</th>
          <th scope="col" class="govuk-table__header" aria-sort="none">Organisation</th>
          <th scope="col" class="govuk-table__header" aria-sort="none">Status</th>
          <th scope="col" class="govuk-table__header" aria-sort="none">Submissions</th>
        </tr>
      </thead>
      <tbody class="govuk-table__body">
        {% for row in model.formMetricRows %}
        <tr class="govuk-table__row" style="display: table-row;">
          <th scope="row" class="govuk-table__header">
            <a href="/library/{{ row.slug }}" class="govuk-link govuk-link--no-visited-state">{{ row.formName }}</a>
          </th>
          <td class="govuk-table__cell">{{ row.organisation }}</td>
          <td class="govuk-table__cell">
            {% if row.status === 'live' %}
              <strong class="govuk-tag govuk-tag--green">Live</strong>
            {% else %}
              <strong class="govuk-tag govuk-tag--yellow">Draft</strong>
            {% endif %}
          </td>
          <td class="govuk-table__cell">{{ row.submissions }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

  {% endcall %}
{% endblock %}
