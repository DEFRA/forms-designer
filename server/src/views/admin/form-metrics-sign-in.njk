{% extends "layouts/page.njk" %}

{% from "page-body/macro.njk" import appPageBody %}
{% from "metrics-overview/macro.njk" import appMetricsOverview %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{%- from "moj/components/filter/macro.njk" import mojFilter -%}
{%- from "govuk/components/checkboxes/macro.njk" import govukCheckboxes -%}
{%- from "govuk/components/radios/macro.njk" import govukRadios -%}
{%- from "govuk/components/input/macro.njk" import govukInput -%}
{% from "page-navigation/macro.njk" import appPageNavigation %}
{% from "metrics-sign-in/macro.njk" import appMetricsSignIn %}

{% set mainClasses = "govuk-main-wrapper--masthead" %}

{% set last7DaysHtml %}
  {{ appMetricsSignIn(model.overviewMetrics.last7Days) }}
{% endset -%}

{% set last30DaysHtml %}
  {{ appMetricsSignIn(model.overviewMetrics.last30Days) }}
{% endset -%}

{% set allTimeHtml %}
  {{ appMetricsSignIn(model.overviewMetrics.allTime) }}
{% endset -%}

{% block content %}
  {% call appPageBody({
    heading: pageHeading,
    caption: caption,
    useNewMasthead: true,
    classes: "govuk-grid-column-full",
    backLink: backLink
  }) %}

    {{ appPageNavigation({
      extraClasses: "govuk-!-margin-bottom-8",
      navItems: [
        {
          title: "Form activity",
          href: "/admin/form-metrics/form-activity/all?restoreFilter=Y"
        },
        {
          title: "Component usage",
          href: "/admin/form-metrics/component-usage"
        },
        {
          title: "Sign-in",
          href: "/admin/form-metrics/sign-in",
          active: true
        }
      ]
    }) }}

    <p class="govuk-body govuk-!-margin-bottom-6">Monitor registrations, sign-ins, account updates and recovery across Defra Forms.</p>

    {{ govukTabs({
      items: [
        {
          label: "Last 7 days",
          id: "last-7-days",
          panel: {
            html: last7DaysHtml
          }
        },
        {
          label: "Last 30 days",
          id: "last-30-days",
          panel: {
            html: last30DaysHtml
          }
        },
        {
          label: "All time",
          id: "all-time",
          panel: {
            html: allTimeHtml
          }
        }
      ]
    }) }}

  {% endcall %}
{% endblock %}
