{% extends "layouts/page.njk" %}

{% from "page-body/macro.njk" import appPageBody %}
{% from "metrics-overview/macro.njk" import appMetricsOverview %}
{% from "govuk/components/tabs/macro.njk" import govukTabs %}
{% from "page-navigation/macro.njk" import appPageNavigation %}

{% set mainClasses = "govuk-main-wrapper--masthead" %}

{% macro displayMetricValue(value) %}
{% if value %}
{{ value | formatNumber }}
{% else %}
0
{% endif %}
{% endmacro %}

{% macro displayMetricPercent(value) %}
{% if value %}
{{ value }}
{% else %}
0%
{% endif %}
{% endmacro %}

{% set questionTypesHtml %}
  {%- include "./admin/form-metrics-component-question-types.njk" -%}
{% endset -%}

{% set featuresHtml %}
  {%- include "./admin/form-metrics-component-features.njk" -%}
{% endset -%}

{% set formStructureHtml %}
  {%- include "./admin/form-metrics-component-form-structure.njk" -%}
{% endset -%}

{% block content %}
  {% call appPageBody({
    heading: pageHeading,
    caption: caption,
    useNewMasthead: true,
    classes: "govuk-grid-column-full",
    backLink: backLink
  }) %}


  {{ appPageNavigation({
    extraClasses: "govuk-!-margin-bottom-8",
    navItems: [
      {
        title: "Form activity",
        href: "/admin/form-metrics/form-activity/all?restoreFilter=Y"
      },
      {
        title: "Component usage",
        href: "/admin/form-metrics/component-usage",
        active: true
      },
      {
        title: "Sign-in",
        href: "/admin/form-metrics/sign-in"
      },
      {
        title: "Copy answers",
        href: "/admin/form-metrics/copy-answers"
      }
    ]
  }) }}

  <p class="govuk-body govuk-!-margin-bottom-6">Breakdown of how different components are being used across all forms.</p>

  {{ govukTabs({
    items: [
      {
        label: "Question types",
        id: "question-types",
        panel: {
          html: questionTypesHtml
        }
      },
      {
        label: "Features",
        id: "features",
        panel: {
          html: featuresHtml
        }
      },
      {
        label: "Form structure",
        id: "form-structure",
        panel: {
          html: formStructureHtml
        }
      }
    ]
  }) }}

  {% endcall %}
  {% endblock %}

  {% block mainEnd %}
    {{ super() }}
  {% endblock %}
