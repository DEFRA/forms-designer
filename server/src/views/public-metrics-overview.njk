{% extends "govuk/template.njk" %}

{% from "metrics-tile/macro.njk" import appMetricsTile %}

{% block head %}
  <link href="{{ getAssetPath("stylesheets/application.scss") }}" rel="stylesheet">
  <style type="text/css">
  * { font-family: GDS Transport, arial, sans-serif; }
  </style>
{% endblock %}

{% block header %}{% endblock %}

{% block main %}
  <div class="govuk-grid-row app-prose-scope">
    {{ appMetricsTile(liveFormsTile) }}
    {{ appMetricsTile(liveSubmissionsTile) }}
  </div>
{% endblock %}

{% block footer %}{% endblock %}
